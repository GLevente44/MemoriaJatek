<Window x:Class="MemoriaJatek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MemoriaJatek"
        mc:Ignorable="d"
        Title="Memóriajáték" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <Label Content="Memóriajáték" FontSize="40" FontWeight="Bold"  HorizontalAlignment="Center"/>

            <Label x:Name="pontszam" Content="Megtalált párok: 0 / 4" FontSize="20" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" x:Name="kartyaHelye" HorizontalAlignment="Center" Orientation="Horizontal"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">

            <Button Content="Új játék" Width="120" Height="40" Margin="10" Click="UjJatek"/>

        </StackPanel>
    </Grid>
</Window>
